{
  "buildCommand": "python3 build.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ],
  "redirects": [
    { "source": "/rebates/maryland/", "destination": "/maryland/", "permanent": true },
    { "source": "/rebates/dc/", "destination": "/dc/", "permanent": true },
    { "source": "/rebates/virginia/", "destination": "/virginia/", "permanent": true },
    { "source": "/checklist/", "destination": "/before-you-sign/", "permanent": true }
  ]
}
